# ============================================================
#  C++ 学习项目 .gitignore
#  把编译产物、IDE 配置、临时文件都排除掉
# ============================================================

# ---------- 构建产物 ----------
build/
cmake-build-*/
out/
bin/
lib/
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.app

# ---------- CMake 生成物 ----------
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
compile_commands.json
install_manifest.txt

# ---------- 依赖文件（make 自动生成）----------
*.d
*.dSYM/
.deps/

# ---------- 调试与性能分析产物 ----------
*.gcda
*.gcno
*.gcov
core
core.*
vgcore.*
perf.data*
gmon.out

# ---------- Sanitizer 输出 ----------
asan.*
ubsan.*
tsan.*

# ---------- IDE / 编辑器 ----------
.vscode/
.idea/
*.swp
*.swo
*~
.cache/
.clangd/

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- TRAE 生成的分享包（非源码）----------
.trae-html-share-packages/

# ---------- 运行时产生的数据文件 ----------
projects/todo_cli/*.dat
projects/todo_cli/tasks.txt
boost/*.log
boost/logs/
*.json.bak
