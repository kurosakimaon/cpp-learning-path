// ============================================================
//  version.h - 项目版本信息（公共头文件）
// ============================================================
//  放在 include/myproject/ 下，是对外暴露的公共头文件。
//  用命名空间 myproject 组织，避免命名冲突。
// ============================================================

#ifndef MYPROJECT_VERSION_H
#define MYPROJECT_VERSION_H

#include <string>

namespace myproject {

// 版本号——这些值由 CMake 通过 configure_file 填进来
// 这里先给个默认值，实际以生成的 config.h 为准
constexpr int VERSION_MAJOR = @PROJECT_VERSION_MAJOR@;
constexpr int VERSION_MINOR = @PROJECT_VERSION_MINOR@;
constexpr int VERSION_PATCH = @PROJECT_VERSION_PATCH@;

// 获取版本字符串
inline std::string versionString() {
    return std::to_string(VERSION_MAJOR) + "." +
           std::to_string(VERSION_MINOR) + "." +
           std::to_string(VERSION_PATCH);
}

// 获取完整的版本信息（包括构建类型）
std::string fullVersionString();

} // namespace myproject

#endif // MYPROJECT_VERSION_H
