# ============================================================
# 示例 4：完整项目结构 Makefile
# 老师傅压箱底的宝贝，项目级 Makefile 模板
# ============================================================
#
# 【项目目录结构】
#   project/
#   ├── Makefile          ← 就是咱这个文件
#   ├── include/          ← 头文件目录
#   │   ├── calculator.h
#   │   ├── logger.h
#   │   ├── string_helper.h
#   │   └── application.h
#   ├── src/              ← 源文件目录（可以有子目录）
#   │   ├── main.cpp
#   │   ├── app/
#   │   │   └── application.cpp
#   │   ├── math/
#   │   │   └── calculator.cpp
#   │   └── utils/
#   │       ├── logger.cpp
#   │       └── string_helper.cpp
#   ├── obj/              ← 中间文件（.o 和 .d，自动生成）
#   └── bin/              ← 最终可执行文件（自动生成）
#
# 【这个 Makefile 能干嘛？】
#   - 自动发现所有源文件（递归子目录）
#   - 自动生成头文件依赖（改了头文件只重编需要的）
#   - 自动创建输出目录
#   - 支持调试版/发布版切换
#   - 支持静态库/动态库链接
#   - 提供常用目标：all clean run debug install dist
# ============================================================


# ============================================================
# 一、目录结构变量
# ============================================================
# 把目录路径定义成变量，改起来方便
# 就像给每个房间起个名字，找人的时候好喊

# 源文件根目录
SRC_DIR := src

# 头文件目录
INC_DIR := include

# 中间文件目录（.o 和 .d 都放这里）
OBJ_DIR := obj

# 可执行文件输出目录
BIN_DIR := bin

# 库文件目录（如果有自己编译的库放这里）
LIB_DIR := lib

# 安装目录前缀
PREFIX := /usr/local


# ============================================================
# 二、编译器与编译选项
# ============================================================

# C++ 编译器（g++ 或 clang++）
CXX := g++

# 编译选项
# -Wall -Wextra  打开常用警告（好习惯！）
# -std=c++17     使用 C++17 标准
# -I$(INC_DIR)   头文件搜索路径（#include "xxx.h" 时会来这里找）
CXXFLAGS := -Wall -Wextra -std=c++17 -I$(INC_DIR)

# 链接选项
# -L$(LIB_DIR)   库文件搜索路径
# -lm            链接数学库（这个示例用不上，放着当例子）
LDFLAGS := -L$(LIB_DIR)
LDLIBS  := -lm

# ============================================================
# 三、构建模式：Debug vs Release
# ============================================================
# 用法：
#   make             → 默认 Debug 模式
#   make MODE=debug  → Debug 模式
#   make MODE=release → Release 模式

MODE ?= debug
#
# ?= 的意思是：如果变量没定义就赋值，已经定义了就保持原样
# 这样可以通过命令行覆盖：make MODE=release

ifeq ($(MODE), release)
    # Release 模式：优化 + 去掉调试信息 + 定义 NDEBUG 宏
    CXXFLAGS += -O2 -DNDEBUG
    MODE_STR := Release
else
    # Debug 模式：不优化 + 调试信息 + 定义 DEBUG 宏
    CXXFLAGS += -O0 -g -DDEBUG
    MODE_STR := Debug
endif


# ============================================================
# 四、自动发现源文件
# ============================================================

# 找出 src/ 目录下所有 .cpp 文件（包括子目录）
# 注意：wildcard 只能找一层目录，要递归得用 shell find 命令
# 或者用 Make 4.x 的 $(wildcard src/**/*.cpp)
# 为了兼容性，咱用 shell find，靠谱

# 用 find 命令递归查找所有 .cpp 文件
SRCS := $(shell find $(SRC_DIR) -name '*.cpp' -type f)
#
# 【解释】
# $(shell 命令) —— 执行 shell 命令，把输出结果作为返回值
# find 命令参数：
#   $(SRC_DIR)   从 src/ 开始找
#   -name '*.cpp' 名字匹配 .cpp
#   -type f      只找文件（不找目录）
#
# 结果大概长这样：
#   src/main.cpp src/app/application.cpp src/math/calculator.cpp ...
#
# 【老师傅提醒】
# 用 shell 函数要注意跨平台。
# Windows 上没有 find 命令，但 MinGW 和 WSL 都有。
# 纯 Windows 环境可能得换种写法，咱这里以 GNU/Linux 环境为主。


# ============================================================
# 五、生成 .o 和 .d 文件路径
# ============================================================

# 把每个 .cpp 文件的路径，转换成对应的 .o 文件路径
# 比如：src/app/application.cpp → obj/app/application.o
#
# 怎么转？两步走：
#   1. 把 src/ 前缀换成 obj/
#   2. 把 .cpp 后缀换成 .o
#
# 用 patsubst 两次就行

# 第一步：替换前缀（src/ → obj/）
TEMP_OBJS := $(patsubst $(SRC_DIR)/%,$(OBJ_DIR)/%,$(SRCS))

# 第二步：替换后缀（.cpp → .o）
OBJS := $(patsubst %.cpp,%.o,$(TEMP_OBJS))
#
# 也可以合并成一步：
# OBJS := $(patsubst $(SRC_DIR)/%.cpp,$(OBJ_DIR)/%.o,$(SRCS))
# 分开写是为了让你看得更清楚

# 依赖文件（.d 文件，自动生成的头文件依赖）
# 把 .o 换成 .d 就行
DEPS := $(patsubst %.o,%.d,$(OBJS))


# ============================================================
# 六、最终目标
# ============================================================

# 可执行文件名
TARGET := $(BIN_DIR)/myapp

# 默认目标：all
.PHONY: all
all: $(TARGET)
	@echo ""
	@echo "========== 构建完成 =========="
	@echo "模式: $(MODE_STR)"
	@echo "输出: $(TARGET)"
	@echo "=============================="


# ============================================================
# 七、链接：生成最终可执行文件
# ============================================================

# 目标依赖所有 .o 文件
$(TARGET): $(OBJS) | $(BIN_DIR)
#                      ^
#                      |
#                      +-- 顺序依赖（order-only prerequisite）
#
# 【什么是顺序依赖？】
# 普通依赖 A: B C  —— B或C变了，A就要重建
# 顺序依赖 A: B | C —— 只有C不存在的时候，先建C，但C变了A不重建
#
# 目录就适合用顺序依赖：目录存在就行，目录的修改时间变了不关我们的事
# 不然你往目录里加个文件，所有目标都要重编，那不乱套了

	$(CXX) $(CXXFLAGS) -o $@ $^ $(LDFLAGS) $(LDLIBS)
#
# $@ → 目标（bin/myapp）
# $^ → 所有依赖（所有 .o 文件）


# ============================================================
# 八、模式规则：编译 .cpp 生成 .o + 自动生成依赖 .d
# ============================================================
# 这是整个 Makefile 最核心的部分
#
# 【自动依赖生成原理】
# 编译器（gcc/g++/clang）有个 -MMD 选项，可以生成 .d 文件。
# .d 文件里就是这个 .cpp 依赖哪些头文件，格式跟 Makefile 规则一样。
# 编译的时候顺手就生成了，一举两得。
#
# -MMD  生成依赖文件（不包含系统头文件，用 -MD 则包含）
# -MP   给每个头文件生成一个空目标，避免删了头文件后 make 报错
# -MF   指定依赖文件名（跟 -o 指定目标文件类似）

$(OBJ_DIR)/%.o: $(SRC_DIR)/%.cpp | $(OBJ_DIR)
	@mkdir -p $(dir $@)
#
# 先确保子目录存在
# $(dir $@) 取目标的目录部分，比如 obj/app/application.o → obj/app/
# mkdir -p 递归创建目录，已存在也不报错
#
# 【为什么不用 $(OBJ_DIR) 的顺序依赖来创建子目录？】
# 因为 $(OBJ_DIR) 只能保证 obj/ 存在，
# 子目录 obj/app/ obj/math/ 这些还是得自己建。
# 所以在命令里先 mkdir -p 一下子目录，最稳妥。

	$(CXX) $(CXXFLAGS) -MMD -MP -MF $(@:.o=.d) -c $< -o $@
#
# 拆解一下这一长串：
#   $(CXX)          编译器（g++）
#   $(CXXFLAGS)     编译选项
#   -MMD            生成依赖文件（不包含系统头文件）
#   -MP             给每个头文件生成空目标（防报错）
#   -MF $(@:.o=.d)  依赖文件名，把目标的 .o 换成 .d
#                   比如 $@ 是 obj/main.o，那就是 obj/main.d
#   -c $<           只编译不链接，输入是第一个依赖（.cpp 文件）
#   -o $@           输出到目标文件（.o 文件）
#
# 【老师傅的重点提醒】
# 这一行命令做了两件事：
#   1. 编译 .cpp → .o
#   2. 顺手生成 .d 依赖文件
#
# 这样每次编译，依赖关系都会自动更新。
# 你改了头文件，make 自动知道哪些 .o 需要重编。
# 这就是"自动依赖生成"的精髓！


# ============================================================
# 九、包含自动生成的 .d 依赖文件
# ============================================================
# 生成了 .d 文件，得把它们包含进来才有用。
#
# -include 前面的减号很重要：
#   - 如果 .d 文件不存在（比如第一次编译），不报错，继续走
#   - 如果存在，就包含进来
#
# 第一次编译的时候没有 .d 文件，没关系，
# 反正所有 .o 都还没有，都会被编译。
# 编译完 .d 文件就有了，下次就能用了。

-include $(DEPS)


# ============================================================
# 十、目录创建
# ============================================================
# 用顺序依赖调用这些目标，确保目录存在

$(BIN_DIR):
	mkdir -p $(BIN_DIR)

$(OBJ_DIR):
	mkdir -p $(OBJ_DIR)

$(LIB_DIR):
	mkdir -p $(LIB_DIR)


# ============================================================
# 十一、常用伪目标
# ============================================================

.PHONY: all clean run debug install dist help info rebuild


# ---- clean：清理所有生成的文件 ----
clean:
	rm -rf $(OBJ_DIR) $(BIN_DIR)
	@echo "清理完成！"

# 【注意】
# rm -rf 是强制递归删除，用的时候小心点！
# 千万别写成 rm -rf / 这种，那就是删库跑路级别的事故了。


# ---- run：编译并运行 ----
run: $(TARGET)
	@echo ""
	@echo "========== 运行程序 =========="
	@$(TARGET)
#
# $(TARGET) 前面加了 @，不会把命令打印出来
# 输出更干净


# ---- debug：用 gdb 调试 ----
debug: $(TARGET)
	@echo "启动 gdb 调试..."
	gdb $(TARGET)
#
# 前提是你装了 gdb，而且用 Debug 模式编译的（有 -g 选项）
# Release 模式去掉了调试信息，gdb 不好使


# ---- rebuild：清理后重新编译 ----
# 有时候你想彻底重编一遍，就用这个
rebuild: clean all


# ---- install：安装到系统 ----
install: $(TARGET)
	@echo "安装到 $(PREFIX)/bin ..."
	install -d $(PREFIX)/bin
	install -m 755 $(TARGET) $(PREFIX)/bin/
	@echo "安装完成！"
#
# install 命令比 cp 专业，可以设置权限、创建目录
# -m 755 设置权限为 rwxr-xr-x（所有者可读写执行，其他只读执行）


# ---- dist：打包发布 ----
# 把项目打包成 tar.gz 压缩包
dist: clean
	@echo "打包中..."
	tar -czf myproject.tar.gz --exclude='*.tar.gz' .
	@echo "打包完成：myproject.tar.gz"


# ---- info：打印构建信息（调试 Makefile 用） ----
info:
	@echo "========== 构建信息 =========="
	@echo "编译器:       $(CXX)"
	@echo "编译选项:     $(CXXFLAGS)"
	@echo "链接选项:     $(LDFLAGS) $(LDLIBS)"
	@echo "构建模式:     $(MODE_STR)"
	@echo ""
	@echo "源文件目录:   $(SRC_DIR)"
	@echo "头文件目录:   $(INC_DIR)"
	@echo "目标文件目录: $(OBJ_DIR)"
	@echo "输出目录:     $(BIN_DIR)"
	@echo ""
	@echo "源文件列表:"
	@echo "  $(SRCS)"
	@echo ""
	@echo "目标文件列表:"
	@echo "  $(OBJS)"
	@echo ""
	@echo "依赖文件列表:"
	@echo "  $(DEPS)"
	@echo "=============================="


# ---- help：帮助信息 ----
help:
	@echo "可用的 make 目标："
	@echo "  all      - 构建项目（默认）"
	@echo "  run      - 编译并运行程序"
	@echo "  clean    - 清理生成的文件"
	@echo "  rebuild  - 清理后重新构建"
	@echo "  debug    - 用 gdb 调试程序"
	@echo "  install  - 安装到系统"
	@echo "  dist     - 打包发布"
	@echo "  info     - 显示构建信息"
	@echo "  help     - 显示此帮助"
	@echo ""
	@echo "构建模式："
	@echo "  make MODE=debug    - 调试模式（默认）"
	@echo "  make MODE=release  - 发布模式"
	@echo ""
	@echo "示例："
	@echo "  make                # Debug 编译"
	@echo "  make MODE=release   # Release 编译"
	@echo "  make run            # 编译并运行"
	@echo "  make clean          # 清理"


# ============================================================
# 十二、静态库与动态库（扩展知识）
# ============================================================
# 徒弟，这部分咱就先演示一下语法，不实际用到。
# 你知道有这么回事就行，以后项目用到了再研究。

# 【静态库 .a】
# 静态库就是把一堆 .o 文件打包到一起，链接的时候整个塞进可执行文件里。
# 生成方法：
#   ar rcs libxxx.a obj1.o obj2.o obj3.o
#
# 示例规则（注释掉了，演示用）：
# lib/libutils.a: $(UTIL_OBJS) | $(LIB_DIR)
# 	ar rcs $@ $^

# 【动态库 .so（Linux）或 .dylib（Mac）或 .dll（Windows）】
# 动态库不塞进可执行文件，运行的时候才加载。
# 编译要加 -fPIC（位置无关代码），链接要加 -shared
#
# 示例（注释掉了，演示用）：
# lib/libutils.so: $(UTIL_OBJS) | $(LIB_DIR)
# 	$(CXX) -shared -o $@ $^
#
# 编译 .o 的时候要加 -fPIC：
# CXXFLAGS += -fPIC

# 【链接库】
# 链接的时候用 -lxxx，比如 -lm 链接数学库
# 搜索路径用 -L，比如 -L./lib
# 这些都已经在 LDFLAGS 和 LDLIBS 变量里预留了位置


# ============================================================
# 老师傅的最终叮嘱
# ============================================================
#
# 徒弟啊，看到这儿，你已经把 Makefile 的核心知识都过了一遍。
# 但要记住：
#
# 1. 这个 Makefile 是个"模板"，不是万能的。
#    不同的项目有不同的需求，你得会改。
#
# 2. Makefile 的学问深着呢，咱这只是冰山一角。
#    但这些内容足够你应付 90% 的日常开发场景了。
#
# 3. 遇到问题多查文档，GNU Make 的官方文档写得非常详细。
#    英文不好也没关系，网上中文资料也很多。
#
# 4. 别忘了 make info 和 make help，
#    自己写的 Makefile 过俩月你也可能忘。
#
# 5. 最重要的：实践出真知。
#    光看不练假把式，自己动手改改试试，踩踩坑，印象才深。
