# ============================================================
# 示例 2：变量与伪目标 —— 让 Makefile 更专业
# 老师傅带你上第二个台阶
# ============================================================

# ---- 变量定义 ----
# 徒弟你看，把重复的东西定义成变量，就像C语言里的 #define
# 改一处，处处生效，维护起来方便得很
#
# 变量命名惯例（大家都这么写，形成默契了）：
#   CC      —— C 编译器
#   CXX     —— C++ 编译器
#   CFLAGS  —— C 编译选项
#   CXXFLAGS —— C++ 编译选项
#   LDFLAGS —— 链接选项
#   OBJS    —— 目标文件列表
#   TARGET  —— 最终生成的目标

# C++ 编译器，默认用 g++
CXX = g++

# 编译选项：
#   -Wall    打开所有警告（强烈建议！）
#   -g       生成调试信息（gdb调试需要）
#   -std=c++11  使用 C++11 标准
CXXFLAGS = -Wall -g -std=c++11

# 目标文件列表：所有 .cpp 编译后生成的 .o 文件
OBJS = main.o utils.o

# 最终生成的可执行文件名
TARGET = app

# 链接选项（这个示例暂时不用，先放这儿占个位置）
LDFLAGS =


# ============================================================
# 第一条规则：默认目标
# ============================================================
# 目标 all 依赖于 $(TARGET)，也就是 app
# 意思是：要完成 all，先得把 app 造出来
#
# 为什么要弄个 all？因为第一条规则是默认执行的，
# 把 all 放最前面，语义更清晰——"全部编译"
all: $(TARGET)
	@echo "========== 编译完成！=========="
#
# @ 符号的作用：不显示命令本身，只显示命令的输出
# 不加 @ 的话，会先把 echo 那行打印出来再执行
# 加上 @ 就干净多了
#
# 徒弟你记住：@ 就是"安静模式"，只干活不吆喝。


# ============================================================
# 第二条规则：链接生成最终可执行文件
# ============================================================
# 目标 app 依赖于所有 .o 文件
# 命令用 $^ 和 $@ 这两个"自动变量"
#
# 【自动变量是什么？】
# 自动变量就是 make 自动帮你填的变量，不用你手动写
# 最常用的有三个：
#   $@  —— 当前规则的目标名（target）
#   $^  —— 所有依赖文件（所有 prerequisites）
#   $<  —— 第一个依赖文件（第一个 prerequisite）
#
# 就像给你递工具的小徒弟，要啥递啥。

$(TARGET): $(OBJS)
	$(CXX) $(CXXFLAGS) -o $@ $^ $(LDFLAGS)
#        ^      ^        ^   ^  ^
#        |      |        |   |  |
#        |      |        |   |  +-- 所有依赖（main.o utils.o）
#        |      |        |   +----- 目标名（app）
#        |      |        +--------- 输出选项
#        |      +------------------ 编译选项变量
#        +------------------------- 编译器变量
#
# 展开后相当于：
#   g++ -Wall -g -std=c++11 -o app main.o utils.o


# ============================================================
# 第三条规则：main.o 怎么来的？
# ============================================================
# main.o 依赖于 main.cpp 和 utils.h（因为 main.cpp include 了 utils.h）
# 用 $< 表示第一个依赖（也就是 main.cpp）
main.o: main.cpp utils.h
	$(CXX) $(CXXFLAGS) -c $< -o $@
#                        ^     ^
#                        |     |
#                        |     +-- 输出为 main.o
#                        +-------- 编译 main.cpp
# -c 选项：只编译不链接，生成 .o 目标文件


# ============================================================
# 第四条规则：utils.o 怎么来的？
# ============================================================
utils.o: utils.cpp utils.h
	$(CXX) $(CXXFLAGS) -c $< -o $@


# ============================================================
# 伪目标 .PHONY
# ============================================================
# 徒弟，这玩意儿很重要，咱得好好说说。
#
# 【什么是伪目标？】
# 伪目标就是"假的目标"——它不对应真实的文件。
# 比如 clean、all、install 这些，都是要执行一些动作，
# 不是要生成叫 clean 的文件。
#
# 【为什么需要 .PHONY？】
# 想象一下：如果当前目录下刚好有个叫 clean 的文件，
# make 一看"clean 存在，又没有依赖，那它就是最新的"，
# 你敲 make clean，它告诉你啥也不用干。这就尴尬了！
#
# 声明 .PHONY 之后，make 就知道：
# "哦，这是个伪目标，不用检查文件，直接执行命令就行。"
#
# 【新手警告】
# 这是 Makefile 的"最佳实践"之一。
# 凡是不生成文件的目标，统统加上 .PHONY，
# 可以避免很多莫名其妙的问题。

.PHONY: all clean install run
#        ^   ^     ^       ^
#        |   |     |       |
#        |   |     |       +-- 运行程序
#        |   |     +---------- 安装（复制到系统目录）
#        |   +---------------- 清理
#        +-------------------- 全部编译


# ============================================================
# clean：清理生成的文件
# ============================================================
clean:
	rm -f $(OBJS) $(TARGET)
	@echo "清理完毕，目录干干净净！"
#
# rm -f 是 Linux/Mac 的删除命令
# -f 是 force 的意思，删不掉也不报错
#
# 【Windows 用户注意】
# Windows 上没有 rm，用的是 del。
# 不过咱这是 GNU Make 教程，主要面向类 Unix 环境。
# Windows 上可以装 MinGW 或者 WSL，体验一样的。


# ============================================================
# run：运行程序
# ============================================================
run: $(TARGET)
	./$(TARGET)
#
# 这个目标依赖于 $(TARGET)，确保程序已经编译好了再运行
# 你改了源码，直接 make run，它会自动先编译再运行
# 方便得很


# ============================================================
# install：安装程序到系统目录
# ============================================================
# 这个示例比较简单，就是把可执行文件复制到 /usr/local/bin
# 真实项目的 install 可能要复制很多文件
PREFIX = /usr/local
BINDIR = $(PREFIX)/bin

install: $(TARGET)
	@echo "正在安装到 $(BINDIR) ..."
	cp $(TARGET) $(BINDIR)/$(TARGET)
	@echo "安装完成！"
#
# 【老师傅提醒】
# 安装到系统目录通常需要管理员权限，得用 sudo make install
# 咱这个示例就演示一下，你真要装的时候小心点哈。
