# ============================================================
# config.mk —— 配置文件
# 演示 include 的用法：把配置单独放一个文件
# 主 Makefile 里用 include config.mk 把它包含进来
# ============================================================
#
# 为什么要单独弄个配置文件？
# 大项目里，配置可能很多，放单独文件里：
#   1. 主 Makefile 更干净
#   2. 别人改配置不用动主 Makefile
#   3. 多个 Makefile 可以共享配置
#
# 就像 C 语言里的头文件一样，把公共的东西抽出来。

# 编译器
CXX = g++

# 编译选项
# -Wall    打开所有警告
# -g       调试信息
# -std=c++11  C++11标准
CXXFLAGS = -Wall -g -std=c++11

# 链接选项（暂时为空）
LDFLAGS =

# 最终目标名
TARGET = demo
