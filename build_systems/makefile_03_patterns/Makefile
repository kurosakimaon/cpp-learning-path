# ============================================================
# 示例 3：模式规则与函数 —— 让 Makefile "自动"起来
# 老师傅带你进入自动化的大门
# ============================================================

# ---- 包含其他 Makefile ----
# include 就像 C 语言的 #include，把别的文件内容插进来
# 这里把配置都放到 config.mk 里，主 Makefile 更清爽
#
# 【注意】
# 如果 include 的文件不存在，make 会报错然后停下来。
# 如果你想"有就包含，没有就算了"，可以用 -include（前面加个减号）
include config.mk


# ============================================================
# 一、wildcard 函数：自动发现源文件
# ============================================================
# 徒弟，上节课咱手动列 OBJS = main.o utils.o，
# 文件少还行，文件多了累死你，加个新文件还得改 Makefile。
#
# wildcard 函数就是干这个的：用通配符找文件。
# 语法：$(wildcard 模式)
# 返回所有匹配模式的文件名，空格分隔

# 找出当前目录下所有 .cpp 文件
SRCS = $(wildcard *.cpp)
#
# 假设目录下有 main.cpp math_utils.cpp string_utils.cpp
# 那么 SRCS 的值就是：main.cpp math_utils.cpp string_utils.cpp
#
# 【老师傅提醒】
# wildcard 是 Makefile 里最常用的函数之一。
# 加新源文件不用改 Makefile，往目录里一扔就行，自动发现！


# ============================================================
# 二、patsubst 函数：批量替换文件名
# ============================================================
# 有了所有 .cpp 文件，咱需要对应的 .o 文件列表。
# 总不能手动一个个改后缀吧？patsubst 来帮你。
#
# 语法：$(patsubst 模式, 替换模式, 文本)
# 作用：把文本中匹配"模式"的词，替换成"替换模式"
# 模式里的 % 是通配符，匹配任意字符

# 把所有 .cpp 替换成 .o
OBJS = $(patsubst %.cpp, %.o, $(SRCS))
#
# 展开过程：
#   SRCS = main.cpp math_utils.cpp string_utils.cpp
#   patsubst 把每个 .cpp 换成 .o
#   OBJS = main.o math_utils.o string_utils.o
#
# 【另一种写法：$(SRCS:.cpp=.o)】
# 这是 patsubst 的简写形式，效果一样：
#   OBJS = $(SRCS:.cpp=.o)
# 但 patsubst 功能更强，可以用 % 做更复杂的替换。


# ============================================================
# 三、头文件自动发现（扩展一下）
# ============================================================
# 同样的思路，找出所有 .h 文件
HDRS = $(wildcard *.h)


# ============================================================
# 四、默认目标
# ============================================================
all: $(TARGET)
	@echo "========== 编译成功！=========="
	@echo "源文件: $(SRCS)"
	@echo "目标文件: $(OBJS)"
	@echo "头文件: $(HDRS)"


# ============================================================
# 五、链接目标
# ============================================================
# $@  目标名（$(TARGET) 的值，也就是 demo）
# $^  所有依赖（所有 .o 文件）
$(TARGET): $(OBJS)
	$(CXX) $(CXXFLAGS) -o $@ $^ $(LDFLAGS)


# ============================================================
# 六、模式规则：一条规则搞定所有 .o 文件
# ============================================================
# 徒弟，这是这节课的重头戏！
#
# 上节课咱每个 .o 都写一条规则：
#   main.o: main.cpp xxx.h
#   	...
#   utils.o: utils.cpp xxx.h
#   	...
#
# 文件多了，写得手都酸了。模式规则就是来拯救你的！
#
# 模式规则语法：
#   %.o: %.cpp
#   	命令
#
# % 是通配符，匹配任意字符串。
# 意思是：任何 .o 文件，都由对应的 .cpp 文件编译而来。
# 比如要生成 foo.o，make 自动找 foo.cpp，用下面的命令编译。

%.o: %.cpp $(HDRS)
	$(CXX) $(CXXFLAGS) -c $< -o $@
#
# 【解释】
# %.o       —— 目标模式：所有 .o 文件
# %.cpp     —— 依赖模式：对应的 .cpp 文件
# $(HDRS)   —— 额外依赖：所有头文件（改了头文件所有 .o 都要重编）
# $<        —— 第一个依赖（也就是 %.cpp 匹配到的那个 .cpp）
# $@        —— 目标（也就是 %.o 匹配到的那个 .o）
#
# 【举个例子】
# make 要生成 math_utils.o：
#   % 匹配到 math_utils
#   目标 = math_utils.o
#   依赖 = math_utils.cpp + 所有 .h 文件
#   命令 = g++ -Wall -g -std=c++11 -c math_utils.cpp -o math_utils.o
#
# 完美！一条规则顶 N 条，加新文件根本不用改 Makefile。
#
# 【老师傅的警告】
# 上面的写法把所有 .h 都当成依赖了，改一个头文件所有 .o 都重编。
# 小项目无所谓，大项目就浪费时间了。
# 更高级的做法是"自动生成头文件依赖"，用 -MMD -MP 生成 .d 文件。
# 那个咱放到第4个示例讲，先把模式规则吃透。


# ============================================================
# 七、foreach 函数：遍历列表
# ============================================================
# foreach 就像 C 语言里的 for 循环，对列表里每个元素做点事。
# 语法：$(foreach 变量, 列表, 表达式)
# 作用：把列表里每个元素依次赋值给变量，计算表达式，把结果拼起来。

# 举个例子：给每个源文件名前面加个 src/ 前缀
# （这个示例里用不上，就是演示一下语法）
PREFIXED_SRCS = $(foreach src, $(SRCS), src/$(src))

# 打印出来看看效果（make test 可以看）
test:
	@echo "所有源文件: $(SRCS)"
	@echo "加前缀后: $(PREFIXED_SRCS)"


# ============================================================
# 八、filter / filter-out 函数：过滤列表
# ============================================================
# filter：保留匹配模式的项
# filter-out：去掉匹配模式的项
#
# 语法：$(filter 模式, 文本)
#       $(filter-out 模式, 文本)

# 比如：过滤出文件名里有 utils 的源文件
UTIL_SRCS = $(filter %utils.cpp, $(SRCS))
#
# 结果：math_utils.cpp string_utils.cpp

# 比如：把 main.cpp 从列表里去掉（剩下的就是库文件）
LIB_SRCS = $(filter-out main.cpp, $(SRCS))
#
# 结果：math_utils.cpp string_utils.cpp

# 用 make test2 看看效果
test2:
	@echo "含 utils 的源文件: $(UTIL_SRCS)"
	@echo "去掉 main 后的源文件: $(LIB_SRCS)"


# ============================================================
# 九、条件判断 ifeq
# ============================================================
# Makefile 也支持条件判断，就像 C 语言的 #ifdef。
# 常用的有：
#   ifeq (a, b)    —— 相等
#   ifneq (a, b)   —— 不等
#   ifdef VAR      —— 变量已定义
#   ifndef VAR     —— 变量未定义
#
# 【注意】
# ifeq 前面不能有 TAB（它不是命令）
# 要顶格写，就像规则定义一样

# 判断编译模式：debug 还是 release
# 用法：make BUILD=release  或者  make BUILD=debug
# 默认是 debug
BUILD = debug

ifeq ($(BUILD), release)
    # release 模式：开优化，去掉调试信息
    CXXFLAGS += -O2 -DNDEBUG
    MODE_MSG = "发布模式 (Release)"
else
    # debug 模式：调试信息，不优化
    CXXFLAGS += -O0 -DDEBUG
    MODE_MSG = "调试模式 (Debug)"
endif
#
# 【解释】
# += 是追加：在原来 CXXFLAGS 的基础上再加一些选项
# -O0 不优化，调试的时候用，gdb 跟踪起来方便
# -O2 二级优化，发布的时候用，跑得更快
# -DDEBUG / -DNDEBUG 定义宏，代码里可以用 #ifdef DEBUG 判断
#
# 【老师傅提醒】
# 条件判断是 Makefile 里非常实用的功能。
# 但别写太多条件分支，不然 Makefile 会变得很难读。
# 保持简单！


# ============================================================
# 十、其他常用函数（提一下，有个印象）
# ============================================================
# $(notdir 文件列表)    —— 去掉路径，只留文件名
# $(dir 文件列表)       —— 只留路径，去掉文件名
# $(basename 文件列表)  —— 去掉后缀
# $(suffix 文件列表)    —— 只留后缀
# $(addprefix 前缀, 列表) —— 加前缀（比 foreach 简单）
# $(addsuffix 后缀, 列表) —— 加后缀
# $(sort 列表)          —— 排序并去重
# $(word n, 文本)       —— 取第n个单词
# $(words 文本)         —— 单词个数
#
# 这些函数不用死记硬背，用到的时候查一下就行。
# 记住 wildcard 和 patsubst 就够你应付大部分场景了。


# ============================================================
# 伪目标
# ============================================================
.PHONY: all clean run test test2 info

clean:
	rm -f $(OBJS) $(TARGET)
	@echo "清理完毕！"

run: $(TARGET)
	@echo "运行模式: $(MODE_MSG)"
	./$(TARGET)

# 打印一些信息，方便调试 Makefile
info:
	@echo "===== Makefile 信息 ====="
	@echo "编译器: $(CXX)"
	@echo "编译选项: $(CXXFLAGS)"
	@echo "源文件: $(SRCS)"
	@echo "目标文件: $(OBJS)"
	@echo "头文件: $(HDRS)"
	@echo "构建模式: $(MODE_MSG)"
	@echo "========================="
